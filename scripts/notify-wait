#!/usr/bin/env python3
"""Wait for a reply to an Iris (formerly hnl-notify) notification and print it.

  notify-wait REPLY_HANDLE|NOTIFICATION_ID [--handle-file FILE] [--timeout 60m] [--save-dir DIR] [--url URL] [--json]

The reply handle (returned once when the conversation's first reply:true notification was sent, form
<conversation id>:<secret>) comes from, in this order: a positional argument containing ":", --handle-file,
the NOTIFY_REPLY_HANDLE environment variable. A plain notification id still works for conversations from before
reply handles existed. The handle is never printed.

A reply that arrived while nobody was waiting is kept and collected later with the same handle; it is printed
with a "Late reply (received ...) to: <title>" line first. Attachments the service no longer holds are listed as
"<name>: not available any more".

Long-polls POST /v1/notifications/{id}/replies/claim (at least once, also with --timeout 0) with a waiter id
derived from the reply handle and the last reply printed on this host (kept in ~/.cache/hnl-notify-wait), so a
retry after a lost response, or a new run after one that was killed before printing, gets the same reply. Exit codes: 0 reply printed (even if its attachments could not be saved), 1 error (also: the notification was
cancelled, missed or never sent, so no reply can come), 2 no reply before --timeout.
Base URL: --url, else NOTIFY_URL, else the url of the iris (or, from before the rename, hnl-notify) MCP entry in
~/.claude.json without /mcp (see mcp_entry for the order).
Token: --token-file, else NOTIFY_TOKEN, else that entry's Authorization header. The token is never printed.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import hmac
import http.client
import json
import os
import re
import secrets
import sys
import tempfile
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime
from pathlib import Path
from typing import Any

EXIT_REPLY, EXIT_ERROR, EXIT_TIMEOUT = 0, 1, 2


class Fatal(Exception):
    pass


class Gone(Exception):
    """HTTP 410: the conversation can never get a reply."""


def parse_duration(s: str) -> int:
    """90s, 30m, 2h, 1d, 2h30m (any case); a bare number means minutes (the service's `delay` takes seconds)."""
    t = s.strip()
    if re.fullmatch(r"\d+", t):
        return int(t) * 60
    m = re.fullmatch(r"(?:(\d+)d)?(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", t, re.I)
    if not t or not m:
        raise argparse.ArgumentTypeError(f"not a duration: {s!r} (e.g. 90s, 30m, 2h, 1d, 2h30m)")
    d, h, mi, sec = (int(x or 0) for x in m.groups())
    return d * 86400 + h * 3600 + mi * 60 + sec


MCP_NAMES = ("iris", "hnl-notify")  # the Iris registration first; hnl-notify is the name from before the rename


def mcp_entry(path: Path = Path.home() / ".claude.json") -> dict[str, Any]:
    """The MCP entry for this service in ~/.claude.json: the global scope first, then each project in file order;
    within a scope `iris` before `hnl-notify`. The first entry found is used as a whole, never merged with another
    (an incomplete one is a configuration error in settings(), not a reason to borrow from the next)."""
    try:
        data = json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    projects = data.get("projects")
    scopes = [data] + (list(projects.values()) if isinstance(projects, dict) else [])
    for scope in scopes:
        servers = scope.get("mcpServers") if isinstance(scope, dict) else None
        if not isinstance(servers, dict):
            continue
        for name in MCP_NAMES:
            if isinstance(servers.get(name), dict):
                return {**servers[name], "_name": name}
    return {}


def _entry_note(entry: dict[str, Any], field: str) -> str:
    name = entry.get("_name")
    return f" (the {name} MCP entry in ~/.claude.json has no {field})" if name else ""


def settings(url: str | None, entry: dict[str, Any], token_file: str | Path | None = None) -> tuple[str, str]:
    base = url or os.environ.get("NOTIFY_URL") or re.sub(r"/mcp/?$", "", entry.get("url") or "")
    auth = (entry.get("headers") or {}).get("Authorization") or ""
    if token_file is not None:
        try:
            token = Path(token_file).read_text().strip()
        except (OSError, UnicodeError) as e:
            raise Fatal(f"cannot read token file {str(token_file)!r}: {type(e).__name__}") from None
    else:
        token = os.environ.get("NOTIFY_TOKEN") or re.sub(r"^Bearer\s+", "", auth, flags=re.I)
    if not base:
        raise Fatal(f"no service URL: pass --url or set NOTIFY_URL{_entry_note(entry, 'url')}")
    if not token:
        raise Fatal("no token: set NOTIFY_TOKEN or add the iris MCP entry to ~/.claude.json"
                    f"{_entry_note(entry, 'Authorization header')}")
    return base.rstrip("/"), token


def safe_filename(name: str, taken: set[str]) -> str:
    base = name.replace("\\", "/").rpartition("/")[2]
    base = "".join(c for c in base if unicodedata.category(c)[0] != "C" and c not in ":").strip().lstrip(".")
    base = base or "attachment"
    stem, dot, ext = base.rpartition(".")
    if not dot or not stem:
        stem, ext = base, ""
    if dot and stem:
        ext = ext.encode()[:20].decode(errors="ignore")
    ext_part = f".{ext}" if ext else ""

    def build(n: int) -> str:
        suffix = f"-{n}" if n > 1 else ""
        room = 200 - len((suffix + ext_part).encode())
        return (stem.encode()[:room].decode(errors="ignore").rstrip() or "attachment") + suffix + ext_part

    n = 1
    cand = build(n)
    while cand.lower() in taken:
        n += 1
        cand = build(n)
    taken.add(cand.lower())
    return cand


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a: Any, **k: Any) -> None:
        return None  # a 3xx surfaces as HTTPError; the bearer token never follows a redirect


_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect)  # never via a proxy


def _request(method: str, url: str, token: str, timeout: float, handle: str | None = None) -> tuple[int, bytes]:
    headers = {"Authorization": f"Bearer {token}", "User-Agent": "notify-wait"}
    if handle:
        headers["X-Reply-Handle"] = handle
    req = urllib.request.Request(url, method=method, headers=headers)
    with _OPENER.open(req, timeout=timeout) as r:
        return r.status, r.read()


def _scrub(text: str, handle: str | None) -> str:
    """Never let the handle's secret through into output."""
    secret = (handle or "").partition(":")[2]
    return text.replace(secret, "***") if secret else text


def find_handle(positional: str | None, handle_file: str | None, env: dict[str, str]) -> tuple[str, str | None]:
    """(notification id to claim on, handle). A positional with ':' is the handle; else --handle-file; else
    NOTIFY_REPLY_HANDLE. With a handle and no plain id, the id is the handle's conversation id."""
    pos = (positional or "").strip()
    handle: str | None = None
    if ":" in pos:
        handle, pos = pos, ""
    elif handle_file is not None:
        try:
            handle = Path(handle_file).read_text().strip()
        except (OSError, UnicodeError) as e:
            raise Fatal(f"cannot read handle file: {type(e).__name__}") from None
    else:
        handle = (env.get("NOTIFY_REPLY_HANDLE") or "").strip() or None
    if handle is not None:
        conv, sep, secret = handle.partition(":")
        if not (conv and sep and secret):
            raise Fatal("the reply handle is not valid (expected <conversation id>:<secret>)")
    nid = pos or (handle or "").partition(":")[0]
    if not nid:
        raise Fatal("give the reply handle (argument, --handle-file or NOTIFY_REPLY_HANDLE) or a notification id")
    return nid, handle


def state_file(handle: str | None) -> Path | None:
    """Where this host notes the last reply it printed for a conversation (named by a hash of the handle; holds
    only a reply id). None without a handle or when the cache folder cannot be used."""
    if not handle:
        return None
    d = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "hnl-notify-wait"
    try:
        d.mkdir(mode=0o700, parents=True, exist_ok=True)
    except OSError:
        return None
    return d / hashlib.sha256(handle.encode()).hexdigest()[:32]


def waiter_id(handle: str | None, state: Path | None) -> str:
    """With a reply handle: derived from its secret and the last reply this host printed, so a run that was
    killed after the service handed it a reply gets that reply on the next run, and a run after a printed reply
    waits for the next one. Without a handle (old plain notification ids) or a usable cache: a random id."""
    secret = (handle or "").partition(":")[2]
    if not secret or state is None:
        return secrets.token_hex(12)
    try:
        last = state.read_text().strip()
    except FileNotFoundError:
        last = ""
    except (OSError, UnicodeError):
        return secrets.token_hex(12)
    return hmac.new(secret.encode(), b"notify-wait-waiter:" + last.encode(), hashlib.sha256).hexdigest()[:48]


def remember(state: Path | None, reply_id: str) -> None:
    """Note the printed reply, so the next run uses a new waiter id."""
    if state is None:
        return
    try:
        fd = os.open(state, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(reply_id + "\n")
    except OSError as e:
        print(f"notify-wait: could not note the collected reply ({type(e).__name__}); the next run may print it"
              " again", file=sys.stderr)


def lock_run(state: Path | None) -> Any:
    """One notify-wait at a time per handle on this host: two runs would share a waiter id and print the same
    reply. A second run waits here until the first has finished. Returns the open lock file (or None)."""
    if state is None:
        return None
    try:
        fd = os.open(str(state) + ".lock", os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError:
        return None
    f = os.fdopen(fd, "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("notify-wait: another notify-wait for this reply handle is running; waiting for it to finish",
              file=sys.stderr)
        fcntl.flock(f, fcntl.LOCK_EX)
    return f


def collected(base: str, token: str, nid: str, reply_id: str, handle: str | None) -> None:
    """Tell the service the reply was printed, so no later run (another cache, another host) is handed it again."""
    url = (f"{base}/v1/notifications/{urllib.parse.quote(nid, safe='')}/replies/"
           f"{urllib.parse.quote(reply_id, safe='')}/collected")
    try:
        _request("POST", url, token, timeout=15, handle=handle)
    except Exception as e:  # best effort: the reply is printed already
        print(f"notify-wait: could not mark the reply collected ({type(e).__name__}); a later run may print it"
              " again", file=sys.stderr)


def claim_loop(base: str, token: str, nid: str, deadline: float, handle: str | None = None,
               waiter: str | None = None) -> dict[str, Any] | None:
    waiter = waiter or secrets.token_hex(12)
    failures = 0
    first = True
    while True:
        left = deadline - time.monotonic()
        if left <= 0 and not first:  # always ask once, even with --timeout 0
            return None
        first = False
        wait = int(max(0, min(50, left)))
        url = (f"{base}/v1/notifications/{urllib.parse.quote(nid, safe='')}/replies/claim"
               f"?wait={wait}&waiter={waiter}")
        try:
            status, body = _request("POST", url, token, timeout=wait + 15, handle=handle)
        except urllib.error.HTTPError as e:
            if e.code == 410:
                try:
                    reason = json.loads(e.read()).get("detail")
                except (ValueError, AttributeError):
                    reason = None
                raise Gone(_clean(reason) if isinstance(reason, str) else "the conversation is closed") from None
            if e.code in (401, 403, 404, 422):
                note = ""
                if e.code == 404 and handle and nid != handle.partition(":")[0]:
                    note = " (if the id and the reply handle name different conversations: the reply handle belongs to another conversation)"
                raise Fatal(f"HTTP {e.code}: {_scrub(e.read().decode(errors='replace')[:300], handle)}{note}") from None
            status, body = 0, b""
        except (urllib.error.URLError, OSError, http.client.HTTPException):
            status, body = 0, b""
        if status == 200:
            try:
                return json.loads(body)
            except ValueError:
                status = 0  # malformed body: retry with the same waiter
        if status == 204:
            failures = 0
            if wait == 0:
                time.sleep(min(1.0, max(0.0, left)))
            continue
        failures += 1  # service restarting or unreachable: retry with the same waiter id
        time.sleep(min(20.0, 2.0 ** min(failures, 5), max(0.0, deadline - time.monotonic())))
        if time.monotonic() >= deadline:
            return None


def save_attachments(base: str, token: str, reply: dict[str, Any], save_dir: str | None,
                     handle: str | None = None) -> list[str]:
    wanted = [a for a in reply.get("attachments") or [] if not a.get("purged")]
    if not wanted:
        return []
    try:
        d = Path(save_dir) if save_dir else Path(tempfile.mkdtemp(prefix="notify-reply-"))
        d.mkdir(parents=True, exist_ok=True)
        taken = {p.name.lower() for p in d.iterdir()}
    except OSError as e:
        raise Fatal(f"cannot use attachment folder: {e}") from None
    paths = []
    for a in wanted:
        rel = a["url"]
        if not isinstance(rel, str) or not rel.startswith("/") or rel.startswith("//"):
            raise Fatal("unexpected attachment url from the service")
        url = base + rel
        if urllib.parse.urlsplit(url)[:2] != urllib.parse.urlsplit(base)[:2]:
            raise Fatal("unexpected attachment url from the service")
        try:
            _, data = _request("GET", url, token, timeout=60, handle=handle)
        except (urllib.error.URLError, OSError, http.client.HTTPException) as e:
            raise Fatal(f"could not download {a['filename']!r}: {e}") from None
        try:
            path = d / safe_filename(a["filename"], taken)
            with open(path, "xb") as f:  # never follow or overwrite an existing file
                f.write(data)
        except OSError as e:
            raise Fatal(f"could not save {a['filename']!r}: {e}") from None
        paths.append(str(path))
    return paths


def _clean(s: Any) -> str:
    """Drop control/format characters (terminal escapes) except newline and tab."""
    return "".join(c for c in str(s) if c in "\n\t" or unicodedata.category(c)[0] != "C")


def unavailable(reply: dict[str, Any]) -> list[str]:
    """Names of attachments the service no longer holds (past their retention)."""
    return [str(a.get("filename") or "attachment") for a in reply.get("attachments") or [] if a.get("purged")]


def render(reply: dict[str, Any], paths: list[str]) -> str:
    return _clean(_render(reply, paths))


def _render(reply: dict[str, Any], paths: list[str]) -> str:
    when = datetime.fromisoformat(reply["received_at"].replace("Z", "+00:00")).astimezone()
    title = reply.get("notification_title") or reply["notification_id"]
    lines = []
    if reply.get("late"):  # collected after the grace time; the agent may have asked something else since
        lines.append(f"Late reply (received {when:%Y-%m-%d %H:%M %Z}) to: {title}")
    lines += [f'Reply from {reply["from"]} ({when:%Y-%m-%d %H:%M %Z}) to "{title}" [{reply["id"]}]:', reply["text"]]
    if reply.get("truncated"):
        lines.append("(reply cut at 8000 characters)")
    if paths:
        lines.append("Attachments: " + ", ".join(paths))
    lines += [f"{name}: not available any more" for name in unavailable(reply)]
    if reply.get("dropped_attachments"):
        lines.append("Not kept (over the limit): " + ", ".join(reply["dropped_attachments"]))
    return "\n".join(lines)


def _fmt(seconds: int) -> str:
    return f"{seconds // 60} min" if seconds >= 60 and seconds % 60 == 0 else f"{seconds} s"


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="notify-wait", description="Wait for a reply to an Iris notification.")
    ap.add_argument("notification_id", nargs="?", help="the reply handle, or (older conversations) a notification id")
    ap.add_argument("--handle-file", help="read the reply handle from this file")
    ap.add_argument("--timeout", type=parse_duration, default=3600,
                    help="how long to wait (90s, 30m, 2h, 1d; a bare number is minutes; default 60m). A reply to a"
                         " scheduled notification can only come after it is sent: use --timeout to cover the delay")
    ap.add_argument("--save-dir", help="where to save attachments (default: a new temporary folder)")
    ap.add_argument("--url", help="service base URL (default: NOTIFY_URL or ~/.claude.json)")
    ap.add_argument("--json", action="store_true", help="print the reply as JSON")
    ap.add_argument("--token-file", help="read the token from this file (e.g. a Codex agent's token) instead of"
                                       " NOTIFY_TOKEN / ~/.claude.json")
    args = ap.parse_args(argv)
    try:
        base, token = settings(args.url, mcp_entry(), args.token_file)
        nid, handle = find_handle(args.notification_id, args.handle_file, os.environ)
        state = state_file(handle)
        lock = lock_run(state)  # noqa: F841  (held until the process exits)
        reply = claim_loop(base, token, nid, time.monotonic() + args.timeout, handle, waiter_id(handle, state))
        if reply is None:
            print(f"No reply within {_fmt(args.timeout)}; listener stopped. Replies are kept; run notify-wait again later to collect them.")
            return EXIT_TIMEOUT
        paths: list[str] = []
        failed = ""
        try:
            paths = save_attachments(base, token, reply, args.save_dir, handle)
        except Fatal as e:  # the reply is already claimed by this run: print it anyway
            failed = str(e)
        print(json.dumps({**reply, "saved": paths, "unavailable": unavailable(reply)}, indent=2) if args.json else render(reply, paths))
        remember(state, str(reply["id"]))
        collected(base, token, nid, str(reply["id"]), handle)
        if failed:
            print(f"notify-wait: could not save attachments: {_clean(failed)}", file=sys.stderr)
        return EXIT_REPLY
    except (KeyError, ValueError, TypeError, AttributeError):
        print("notify-wait: unexpected reply format from the service", file=sys.stderr)
        return EXIT_ERROR
    except Gone as e:
        print(f"No reply possible: {e}.")
        return EXIT_ERROR
    except Fatal as e:
        print(f"notify-wait: {e}", file=sys.stderr)
        return EXIT_ERROR
    except KeyboardInterrupt:
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
