#!/usr/bin/env python3
"""Per-host relay for the agent group chats: reports member liveness and delivers wakes.

  chat-relay [--token-file F] [--url URL] [--codex PATH] [--sock-dir DIR] [--once]

Two loops in one process:
  * every 30 s POST /v1/chat/heartbeat listing each open member of this host whose pid is alive and whose
    /proc/<pid>/stat start time (field 22) equals the recorded pid_start; a Codex session inside the shared
    `codex app-server` (whose pid outlives its sessions) counts only while that server lists it as loaded
    (JSON-RPC `thread/loaded/list` on its unix control socket; Codex unloads a thread ~30 s after its last
    client left, e.g. on /exit). A server that cannot be asked leaves the pid check as the answer;
  * claim wakes for this host (waiter "relay-<hostname>") and deliver them: to Codex with
    `codex queue --thread <session_id> --message <text>`, to Claude by writing one JSON line to the session's
    inbox socket <sock-dir>/<pid>.sock. Only a successful delivery is confirmed; a failure is logged and the
    server returns the wake to pending after 120 s.
URL: --url, else NOTIFY_URL, else ~/.config/hnl-notify/url. Token: --token-file, else
~/.config/hnl-notify/chat-token. Logs plain lines to stderr; never the token or the message text.
Errors never stop the relay (back-off 5 s up to 60 s); SIGTERM / SIGINT shut it down cleanly. A configuration
error (no token or URL) exits with 78 (EX_CONFIG), which the systemd unit does not restart.
"""

from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
import re
import shutil
import signal
import socket
import struct
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

HEARTBEAT_INTERVAL = 30.0
CLAIM_WAIT = 25
DELIVER_TIMEOUT = 10.0
BACKOFF_MIN, BACKOFF_MAX = 5.0, 60.0
CONFIRM_TRIES = 4
EXIT_CONFIG = 78  # EX_CONFIG: the unit does not restart on it (RestartPreventExitStatus=78)
SESSION_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$")
CODEX_RPC_TIMEOUT = 3.0  # per control socket of a codex app-server, for the whole exchange (a hard deadline)
CODEX_ROUND_BUDGET = 8.0  # all codex app-server questions of one heartbeat round; after it: unknown (pid check)
CODEX_RPC_MAX_FRAME = 4 << 20
CODEX_RPC_MAX_MESSAGES = 500  # notifications the server may send before our answer
CODEX_LOADED_MAX_PAGES = 50



# --- context reset (0.22.0) ----------------------------------------------------------------------------------------
# The owner asked to clear a session's context: type /clear into its tmux pane, as the owner would. The only text this
# relay ever types is CLEAR, hard-coded here; the server only says which member. Enter is pressed only when the input
# line then holds exactly /clear (an empty line before), else the six characters are taken back ("typed").
CLEAR = "/clear"
TMUX_TIMEOUT = 3.0
PROMPT_CHARS = " \t\u2502|>\u203a\u276f\u25b8\u2771\u00a0"  # box border and prompt glyphs around the input


def _environ(pid: int) -> dict[str, str]:
    try:
        raw = open(f"/proc/{pid}/environ", "rb").read()
    except OSError:
        return {}
    out = {}
    for part in raw.split(b"\x00"):
        k, sep, v = part.partition(b"=")
        if sep:
            out[k.decode(errors="replace")] = v.decode(errors="replace")
    return out


def _ppid(pid: int) -> int | None:
    try:
        stat = open(f"/proc/{pid}/stat").read()
        return int(stat[stat.rindex(")") + 2:].split()[1])
    except (OSError, ValueError, IndexError):
        return None


def _descends(pid: int, ancestor: int) -> bool:
    p: int | None = pid
    for _ in range(64):
        if p is None or p <= 1:
            return False
        if p == ancestor:
            return True
        p = _ppid(p)
    return False


def _tmux(socket_path: str, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["tmux", "-S", socket_path, *args], capture_output=True, text=True, timeout=TMUX_TIMEOUT)


def _pane_of(pid: int) -> tuple[str, str] | None:
    """(tmux socket, pane id) of the pane process pid runs in, verified with tmux: the pane's own process must be
    an ancestor of pid (an environment can be stale or copied)."""
    env = _environ(pid)
    sock, pane = env.get("TMUX", "").split(",", 1)[0], env.get("TMUX_PANE", "")
    if not sock or not re.fullmatch(r"%\d{1,6}", pane):
        return None
    p = _tmux(sock, "display-message", "-p", "-t", pane, "#{pane_pid} #{pane_tty}")
    try:
        pane_pid_s, pane_tty = p.stdout.split()
        pane_pid = int(pane_pid_s)
    except ValueError:
        return None
    if p.returncode != 0 or not _descends(pid, pane_pid):
        return None
    # the process must own the pane's terminal, in its foreground: a session started from inside another agent's
    # pane (its shell running claude or codex) has the same TMUX_PANE but is not what the owner sees there
    try:
        if os.readlink(f"/proc/{pid}/fd/0") != pane_tty:
            return None
        stat = open(f"/proc/{pid}/stat").read()
        fields = stat[stat.rindex(")") + 2:].split()
        if int(fields[2]) != int(fields[5]):  # pgrp != tpgid: not the foreground process group
            return None
    except (OSError, ValueError, IndexError):
        return None
    return sock, pane


def _codex_tuis(folder: str) -> list[int]:
    """Interactive codex processes (not the app-server, exec or queue) running in folder or below it."""
    out = []
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            argv = open(f"/proc/{d}/cmdline", "rb").read().split(b"\x00")
            cwd = os.readlink(f"/proc/{d}/cwd")
        except OSError:
            continue
        if not argv or os.path.basename(argv[0].decode(errors="replace")) != "codex":
            continue
        rest = {a.decode(errors="replace") for a in argv[1:]}
        if rest & {"app-server", "exec", "queue", "mcp", "mcp-server", "proto"}:
            continue
        if cwd == folder:  # exactly the chat's folder: a subfolder can be another chat
            out.append(int(d))
    return out


BORDER_CHARS = " \t\u2500\u2501\u2550\u256d\u256e\u2570\u256f\u250c\u2510\u2514\u2518\u2502\u2503|-_=\u00a0"


def _input_holds_clear(before: str, after: str) -> bool:
    """The input line holds exactly /clear and nothing else is in the input: of the lines that changed when it was
    typed, the topmost one that shows /clear (a suggestion list opens below the input) has nothing else once the
    prompt and box characters are off, and the line above it is the box's edge or empty (so it is not the second
    line of a draft, nor the rest of a draft that wrapped). Lines already on screen (an earlier /clear in the
    history) never count. When unsure: False, and nothing is sent."""
    old = before.splitlines()
    new = after.splitlines()
    for i, line in enumerate(new):
        if CLEAR in line and (i >= len(old) or old[i] != line):
            if line.strip(PROMPT_CHARS) != CLEAR:
                return False
            above = new[i - 1] if i > 0 else ""
            return not above.strip(BORDER_CHARS)
    return False


def type_clear(sock: str, pane: str) -> str:
    """Type CLEAR into the pane; Enter only when the input line held nothing else. reset or typed."""
    if _tmux(sock, "display-message", "-p", "-t", pane, "#{pane_in_mode}").stdout.strip() != "0":
        return "not_found"  # copy mode or similar: keys would go to tmux, not to the agent
    before = _tmux(sock, "capture-pane", "-p", "-t", pane).stdout
    if _tmux(sock, "send-keys", "-t", pane, "-l", CLEAR).returncode != 0:
        return "not_found"
    time.sleep(0.4)
    after = _tmux(sock, "capture-pane", "-p", "-t", pane).stdout
    if not _input_holds_clear(before, after):
        _tmux(sock, "send-keys", "-t", pane, *(["BSpace"] * len(CLEAR)))  # take our text back, leave theirs
        return "typed"
    _tmux(sock, "send-keys", "-t", pane, "Enter")
    return "reset"


def do_reset(r: dict[str, Any]) -> str:
    """Clear the context of the member in r ({kind, pid, pid_start, folder, shared_process}). Returns the outcome
    for the server: reset, typed, not_tmux, not_found or gone."""
    try:
        pid, start = r.get("pid"), r.get("pid_start")
        if not isinstance(pid, int) or pid <= 0 or pid_start(pid) is None or pid_start(pid) != str(start):
            return "gone"
        if r.get("kind") == "claude":
            if not _environ(pid).get("TMUX_PANE"):
                return "not_tmux"
            found = _pane_of(pid)
        elif r.get("kind") == "codex":
            folder = r.get("folder")
            if not isinstance(folder, str) or not folder.startswith("/"):
                return "not_found"
            if r.get("shared_process") and int(r.get("codex_members") or 1) > 1:
                return "not_found"  # several Codex sessions in this chat share one app-server: no guess which window
            tuis = [p for p in _codex_tuis(folder) if r.get("shared_process") or _descends(p, pid) or p == pid]
            in_tmux = [p for p in tuis if _environ(p).get("TMUX_PANE")]
            if not tuis:
                return "not_found"
            if len(tuis) > 1:
                return "not_found"  # two Codex windows in one folder (in tmux or not): no guess
            if not in_tmux:
                return "not_tmux"
            found = _pane_of(in_tmux[0])
        else:
            return "not_found"
        if found is None:
            return "not_found"
        return type_clear(*found)
    except (OSError, subprocess.SubprocessError) as e:
        log(f"reset: {type(e).__name__}")
        return "not_found"

class Fatal(Exception):
    pass


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a: Any, **k: Any) -> None:
        return None  # the bearer token never follows a redirect


_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect)  # never via a proxy


def log(msg: str) -> None:
    print(f"chat-relay: {msg}", file=sys.stderr, flush=True)


def pid_start(pid: int) -> str | None:
    """Start time (clock ticks, field 22) from /proc/<pid>/stat; the comm may hold spaces and parentheses."""
    try:
        raw = Path(f"/proc/{pid}/stat").read_text(errors="replace")
        return raw.rpartition(")")[2].split()[19]
    except (OSError, ValueError, IndexError):
        return None


class _RpcError(Exception):
    pass


def listening_unix_sockets(pid: int) -> list[str]:
    """Filesystem paths of the unix sockets process <pid> listens on (its fds matched against /proc/net/unix)."""
    inodes: set[str] = set()
    try:
        for fd in os.listdir(f"/proc/{pid}/fd"):
            try:
                link = os.readlink(f"/proc/{pid}/fd/{fd}")
            except OSError:
                continue
            if link.startswith("socket:["):
                inodes.add(link[8:-1])
        lines = Path("/proc/net/unix").read_text(errors="replace").splitlines()[1:]
    except OSError:
        return []
    out = []
    for line in lines:  # Num RefCount Protocol Flags Type St Inode [Path]
        f = line.split(None, 7)
        if len(f) == 8 and f[6] in inodes and int(f[3], 16) & 0x10000 and f[7].startswith("/"):  # __SO_ACCEPTCON
            out.append(f[7])
    return out


def _ws_send(s: socket.socket, text: str) -> None:
    data = text.encode()
    n = len(data)
    head = b"\x81" + (bytes([0x80 | n]) if n < 126 else bytes([0x80 | 126]) + struct.pack(">H", n) if n < 65536
                       else bytes([0x80 | 127]) + struct.pack(">Q", n))
    mask = os.urandom(4)
    s.sendall(head + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))


def _recv_exact(s: socket.socket, n: int, deadline: float) -> bytes:
    """n bytes before the deadline: a socket that trickles bytes cannot hold the relay past it."""
    buf = bytearray()
    while len(buf) < n:
        left = deadline - time.monotonic()
        if left <= 0:
            raise _RpcError("too slow")
        s.settimeout(left)
        chunk = s.recv(min(n - len(buf), 65536))
        if not chunk:
            raise _RpcError("closed")
        buf += chunk
    return bytes(buf)


def _ws_recv(s: socket.socket, deadline: float) -> str:
    """One text message (fragments joined); pings answered, a close frame ends the exchange."""
    msg = b""
    while True:
        b1, b2 = _recv_exact(s, 2, deadline)
        op, n = b1 & 0x0F, b2 & 0x7F
        if n == 126:
            n = struct.unpack(">H", _recv_exact(s, 2, deadline))[0]
        elif n == 127:
            n = struct.unpack(">Q", _recv_exact(s, 8, deadline))[0]
        if n + len(msg) > CODEX_RPC_MAX_FRAME:
            raise _RpcError("message too large")
        mask = _recv_exact(s, 4, deadline) if b2 & 0x80 else None
        data = _recv_exact(s, n, deadline)
        if mask:
            data = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
        if op == 0x8:
            raise _RpcError("closed")
        if op == 0x9:
            s.sendall(b"\x8a\x80" + os.urandom(4))  # empty masked pong
            continue
        if op == 0xA:
            continue
        msg += data
        if b1 & 0x80:
            return msg.decode()


def _rpc_result(s: socket.socket, rid: int, deadline: float) -> Any:
    for _ in range(CODEX_RPC_MAX_MESSAGES):
        try:
            m = json.loads(_ws_recv(s, deadline))
        except (ValueError, RecursionError):
            raise _RpcError("not JSON") from None
        if isinstance(m, dict) and type(m.get("id")) is int and m["id"] == rid:
            if "error" in m or "result" not in m:
                raise _RpcError("error answer")
            return m["result"]
    raise _RpcError("no answer")


def codex_loaded_threads_at(path: str, deadline: float | None = None) -> set[str]:
    """Thread ids the codex app-server at control socket <path> has loaded. Raises when it cannot tell, at the latest
    at the deadline (default: CODEX_RPC_TIMEOUT from now)."""
    deadline = min(deadline or float("inf"), time.monotonic() + CODEX_RPC_TIMEOUT)
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(max(0.01, deadline - time.monotonic()))
        s.connect(path)
        key = base64.b64encode(os.urandom(16)).decode()
        s.sendall(f"GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                  f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n".encode())
        head = b""
        while b"\r\n\r\n" not in head:
            if len(head) > 8192 or time.monotonic() > deadline:
                raise _RpcError("bad handshake")
            s.settimeout(max(0.01, deadline - time.monotonic()))
            c = s.recv(1)
            if not c:
                raise _RpcError("closed")
            head += c
        if b" 101 " not in head.split(b"\r\n", 1)[0] + b" ":
            raise _RpcError("not a websocket server")
        _ws_send(s, json.dumps({"id": 1, "method": "initialize",
                                "params": {"clientInfo": {"name": "iris-chat-relay", "title": "Iris chat relay",
                                                          "version": "1"}}}))
        _rpc_result(s, 1, deadline)
        _ws_send(s, json.dumps({"method": "initialized"}))
        loaded: set[str] = set()
        cursor = None
        for page in range(CODEX_LOADED_MAX_PAGES):
            if time.monotonic() > deadline:
                raise _RpcError("too slow")
            rid = 2 + page
            _ws_send(s, json.dumps({"id": rid, "method": "thread/loaded/list",
                                    "params": {"cursor": cursor} if cursor else {}}))
            res = _rpc_result(s, rid, deadline)
            data = res.get("data") if isinstance(res, dict) else None
            if not isinstance(data, list):
                raise _RpcError("unexpected answer")
            loaded.update(x for x in data if isinstance(x, str))
            cursor = res.get("nextCursor")
            if not cursor:
                return loaded
        raise _RpcError("too many pages")


def codex_loaded_threads(pid: int, deadline: float | None = None) -> set[str] | None:
    """SHA-256 (hex) of each session open in the codex app-server <pid> (the server hashes session ids the same way
    and sends only those), or None when no control socket of it answered in time (unknown)."""
    for path in listening_unix_sockets(pid):
        if deadline is not None and time.monotonic() >= deadline:
            return None
        try:
            return {hashlib.sha256(t.encode()).hexdigest() for t in codex_loaded_threads_at(path, deadline)}
        except Exception:  # whatever the socket answers: unknown, never a broken heartbeat
            continue
    return None


def settings(url: str | None, token_file: str | None) -> tuple[str, str]:
    cfg = Path.home() / ".config" / "hnl-notify"
    base = url or os.environ.get("NOTIFY_URL") or ""
    if not base:
        try:
            base = (cfg / "url").read_text().strip()
        except (OSError, UnicodeError):
            pass
    tf = Path(token_file) if token_file else cfg / "chat-token"
    try:
        token = tf.read_text().strip()
    except (OSError, UnicodeError) as e:
        raise Fatal(f"cannot read token file {str(tf)!r}: {type(e).__name__}") from None
    if not base:
        raise Fatal("no service URL: pass --url, set NOTIFY_URL or write ~/.config/hnl-notify/url")
    if not token:
        raise Fatal("the chat token file is empty")
    return base.rstrip("/"), token


class Relay:
    def __init__(self, base: str, token: str, codex: str, sock_dir: str, waiter: str) -> None:
        self.base, self.token, self.codex, self.sock_dir, self.waiter = base, token, codex, sock_dir, waiter
        self.resets_done: dict[str, str] = {}  # reset id -> outcome, so a reset is typed at most once
        self.members: list[dict[str, Any]] | None = None  # open members of this host, from the last heartbeat
        self.codex_closed: set[Any] = set()  # members logged as closed codex sessions (log once)
        self.codex_unknown: set[int] = set()  # app-servers logged as unaskable (log once)
        self.stop = threading.Event()

    # --- HTTP -------------------------------------------------------------------------------------------
    def post(self, path: str, body: dict[str, Any] | None, timeout: float) -> tuple[int, Any]:
        headers = {"Authorization": f"Bearer {self.token}", "Content-Type": "application/json",
                   "User-Agent": "chat-relay"}
        data = json.dumps(body).encode() if body is not None else b""
        req = urllib.request.Request(self.base + path, data=data, method="POST", headers=headers)
        try:
            with _OPENER.open(req, timeout=timeout) as r:
                raw = r.read()
                return r.status, (json.loads(raw) if raw else None)
        except urllib.error.HTTPError as e:
            return e.code, None

    # --- liveness ---------------------------------------------------------------------------------------
    def alive_members(self) -> list[dict[str, Any]]:
        out = []
        loaded: dict[int, set[str] | None] = {}  # one question per codex app-server per round
        budget = time.monotonic() + CODEX_ROUND_BUDGET  # the heartbeat must go out well within STALE_SECONDS
        for m in self.members or []:
            pid, start = m.get("pid"), m.get("pid_start")
            if not (isinstance(pid, int) and pid > 0 and start is not None and pid_start(pid) == str(start)):
                continue
            want = m.get("codex_session_sha256")  # set for a codex session in a shared app-server only
            if m.get("kind") == "codex" and isinstance(want, str):
                if pid not in loaded:
                    try:
                        loaded[pid] = codex_loaded_threads(pid, budget)
                    except Exception:  # e.g. /proc unreadable: unknown
                        loaded[pid] = None
                    if loaded[pid] is None and pid not in self.codex_unknown:
                        self.codex_unknown.add(pid)
                        log(f"codex app-server {pid}: cannot list its open sessions; its pid alone counts")
                    elif loaded[pid] is not None:
                        self.codex_unknown.discard(pid)
                if loaded[pid] is not None and want not in loaded[pid]:
                    if m.get("member_id") not in self.codex_closed:
                        self.codex_closed.add(m.get("member_id"))
                        log(f"member {m.get('member_id')}: its codex session is closed; no longer reported alive")
                    continue
                self.codex_closed.discard(m.get("member_id"))
            out.append({"member_id": m.get("member_id"), "pid": pid, "pid_start": str(start)})
        return out

    def _heartbeat_call(self, alive: list[dict[str, Any]]) -> None:
        status, res = self.post("/v1/chat/heartbeat", {"alive": alive}, 15)
        if status != 200 or not isinstance(res, dict) or not isinstance(res.get("members"), list):
            raise RuntimeError(f"heartbeat failed: HTTP {status}")
        self.members = [m for m in res["members"] if isinstance(m, dict)]

    def heartbeat(self) -> None:
        if self.members is None:  # first round: learn the members (an empty report), then report the live ones
            self._heartbeat_call([])
        self._heartbeat_call(self.alive_members())

    # --- delivery ---------------------------------------------------------------------------------------
    def deliver_codex(self, wake: dict[str, Any]) -> bool:
        sid = wake.get("session_id")
        if not isinstance(sid, str) or not SESSION_ID_RE.match(sid):
            log(f"wake {wake.get('wake_id')}: invalid session id; not delivering")
            return False
        try:  # --opt=value items: neither the id nor the text can be read as another option
            p = subprocess.run([self.codex, "queue", f"--thread={sid}", f"--message={wake['text']}"], timeout=DELIVER_TIMEOUT, stdin=subprocess.DEVNULL,
                               capture_output=True)
        except (OSError, subprocess.SubprocessError) as e:
            log(f"wake {wake.get('wake_id')}: codex queue failed ({type(e).__name__})")
            return False
        if p.returncode != 0:
            log(f"wake {wake.get('wake_id')}: codex queue exited {p.returncode}")
            return False
        return True

    def deliver_claude(self, wake: dict[str, Any]) -> bool:
        pid = wake.get("pid")
        if not isinstance(pid, int) or pid <= 0:
            log(f"wake {wake.get('wake_id')}: member {wake.get('member_id')} has no pid")
            return False
        if pid_start(pid) is None or pid_start(pid) != str(wake.get("pid_start")):
            log(f"wake {wake.get('wake_id')}: pid {pid} is gone or reused; not delivering")
            return False
        line = json.dumps({"type": "user", "message": {"role": "user", "content": wake["text"]}}) + "\n"
        path = os.path.join(self.sock_dir, f"{pid}.sock")
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(DELIVER_TIMEOUT)
                s.connect(path)
                s.sendall(line.encode())
        except OSError as e:
            log(f"wake {wake.get('wake_id')}: socket delivery to pid {pid} failed ({type(e).__name__})")
            return False
        return True

    def deliver(self, wake: dict[str, Any]) -> bool:
        kind = wake.get("kind")
        if kind == "codex":
            return self.deliver_codex(wake)
        if kind == "claude":
            return self.deliver_claude(wake)
        log(f"wake {wake.get('wake_id')}: unknown kind {kind!r}")
        return False

    def claim_once(self, wait: int) -> bool | None:
        """Claim and deliver one wake (or do one context reset). True: done; False: delivery failed; None: nothing
        to do."""
        q = urllib.parse.urlencode({"waiter": self.waiter, "wait": wait, "resets": "true"})
        status, wake = self.post(f"/v1/chat/wakes/claim?{q}", None, wait + 15)
        if status == 204:
            return None
        if status == 200 and isinstance(wake, dict) and wake.get("type") == "reset" and wake.get("reset_id"):
            done = self.resets_done.get(str(wake["reset_id"]))  # a report that failed: report again, never type again
            outcome = done or do_reset(wake)
            self.resets_done[str(wake["reset_id"])] = outcome
            rid = urllib.parse.quote(str(wake["reset_id"]), safe="")
            qs = urllib.parse.urlencode({"waiter": self.waiter})
            status, _ = self.post(f"/v1/chat/resets/{rid}/done?{qs}", {"outcome": outcome}, 15)
            log(f"reset {wake['reset_id']}: {outcome} (member {wake.get('member_id')})"
                + ("" if status == 204 else f"; report answered HTTP {status}"))
            return True
        if status != 200 or not isinstance(wake, dict) or not wake.get("wake_id"):
            raise RuntimeError(f"claim failed: HTTP {status}")
        wid = urllib.parse.quote(str(wake["wake_id"]), safe="")
        qs = urllib.parse.urlencode({"waiter": self.waiter})
        if not self.deliver(wake):
            try:  # give the wake back (delayed retry, or skipped after 5 tries) so it cannot block the others
                status, _ = self.post(f"/v1/chat/wakes/{wid}/release?{qs}", None, 15)
                if status != 204:
                    log(f"wake {wake['wake_id']}: release answered HTTP {status}")
            except Exception as e:
                log(f"wake {wake['wake_id']}: release failed ({type(e).__name__})")
            return False
        self.confirm(wake, f"/v1/chat/wakes/{wid}/confirm?{qs}")
        return True

    def confirm(self, wake: dict[str, Any], path: str) -> None:
        """Confirm a delivered wake, retrying a few times (a lost confirm means the wake is delivered again).
        404: the wake is no longer claimed (the member read it with group_read, or left): nothing to confirm."""
        for n in range(CONFIRM_TRIES):
            if n:
                time.sleep(0.5 * 2 ** (n - 1))
            try:
                status, _ = self.post(path, None, 15)
            except Exception as e:
                log(f"wake {wake['wake_id']}: confirm failed ({type(e).__name__})")
                continue
            if status == 204:
                log(f"wake {wake['wake_id']}: delivered to member {wake.get('member_id')}")
                return
            if status == 404:
                log(f"wake {wake['wake_id']}: delivered; the wake was already closed on the server")
                return
            log(f"wake {wake['wake_id']}: confirm answered HTTP {status}")
        log(f"wake {wake['wake_id']}: delivered but not confirmed after {CONFIRM_TRIES} tries")

    # --- loops ------------------------------------------------------------------------------------------
    def _loop(self, name: str, step: Any, interval: float) -> None:
        backoff = BACKOFF_MIN
        while not self.stop.is_set():
            try:
                delay = step()
                backoff = BACKOFF_MIN
            except Exception as e:  # keep running whatever the server or network does
                log(f"{name}: {type(e).__name__}: {str(e)[:120]}; retrying in {backoff:.0f}s")
                delay, backoff = backoff, min(backoff * 2, BACKOFF_MAX)
            self.stop.wait(interval if delay is None else delay)

    def heartbeat_step(self) -> float:
        self.heartbeat()
        return HEARTBEAT_INTERVAL

    def claim_step(self) -> float:
        self.claim_once(CLAIM_WAIT)
        return 0.0  # a failed wake was released with a delay: go on with the next one

    def run(self) -> int:
        threads = [threading.Thread(target=self._loop, args=("heartbeat", self.heartbeat_step, HEARTBEAT_INTERVAL),
                                    daemon=True),
                   threading.Thread(target=self._loop, args=("claim", self.claim_step, 0.0), daemon=True)]
        for t in threads:
            t.start()
        while not self.stop.wait(0.5):
            pass
        for t in threads:
            t.join(timeout=2)
        log("stopped")
        return 0


def check_claude_version() -> None:
    exe = shutil.which("claude")
    if not exe:
        return
    try:
        out = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=10,
                             stdin=subprocess.DEVNULL).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return
    if not re.match(r"2\.1\.", out):
        log(f"warning: claude version {out[:40]!r}; the inbox socket format is untested on it")


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="chat-relay", description="Deliver agent group chat wakes; report liveness.")
    ap.add_argument("--url", help="service base URL (default: NOTIFY_URL or ~/.config/hnl-notify/url)")
    ap.add_argument("--token-file", help="chat token file (default: ~/.config/hnl-notify/chat-token)")
    ap.add_argument("--codex", default="codex", help="codex executable (default: codex on PATH)")
    ap.add_argument("--sock-dir", default=f"/run/user/{os.getuid()}/cc-socks",
                    help="directory of the Claude inbox sockets (default: /run/user/<uid>/cc-socks)")
    ap.add_argument("--once", action="store_true", help="one heartbeat and one claim, then exit (tests)")
    args = ap.parse_args(argv)
    try:
        base, token = settings(args.url, args.token_file)
    except Fatal as e:
        print(f"chat-relay: {e}", file=sys.stderr)
        return EXIT_CONFIG
    relay = Relay(base, token, args.codex, args.sock_dir, f"relay-{socket.gethostname()}")
    check_claude_version()
    if args.once:
        try:
            relay.heartbeat()
            relay.claim_once(0)
        except Exception as e:
            log(f"{type(e).__name__}: {str(e)[:120]}")
            return 1
        return 0
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: relay.stop.set())
    log("started")
    return relay.run()


if __name__ == "__main__":
    sys.exit(main())
